AGENTOS_ENV=dev
# Loopback only. Change deliberately; non-dev refuses 0.0.0.0 (see app/config.py).
AGENTOS_HOST=127.0.0.1
AGENTOS_PORT=8080

# Control Plane token for /v1/* . Generate a random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Non-dev environments refuse to start unless this is set (>= 16 chars).
# This is NOT a master secret and NOT the future identity system.
AGENTOS_CONTROL_TOKEN=

# Local placeholder only. Set a real value before any non-dev use; the app
# refuses to start with this placeholder when AGENTOS_ENV is not dev/test/local.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://agentos:change-me@postgres:5432/agentos
REDIS_URL=redis://redis:6379/0

# Comma-separated Telegram user IDs allowed to become owner identities later.
# Do not put bot tokens or model API keys here until the secrets layer is implemented.
OWNER_TELEGRAM_IDS=
