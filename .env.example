AGENTOS_ENV=dev
# Loopback only. Change deliberately; non-dev refuses 0.0.0.0 (see app/config.py).
AGENTOS_HOST=127.0.0.1
AGENTOS_PORT=8080

# Control Plane token for /v1/* . Generate a random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Non-dev environments refuse to start unless this is set (>= 16 chars).
AGENTOS_CONTROL_TOKEN=

# Local placeholder only. Set a real value before any non-dev use; the app
# refuses to start with this placeholder when AGENTOS_ENV is not dev/test/local.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://agentos:change-me@postgres:5432/agentos
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Telegram (Sprint 2). Long polling: no inbound port, no webhook.
# ---------------------------------------------------------------------------
# Comma-separated NUMERIC Telegram user ids allowed to use the bots. Deny by
# default: a bot token with an empty allowlist refuses to start.
OWNER_TELEGRAM_IDS=

# Bot tokens from @BotFather. Env only — never commit, never log.
# Two separate bots: Courier solves tasks; Intelligence is a direct chat.
COURIER_TELEGRAM_BOT_TOKEN=
INTELLIGENCE_TELEGRAM_BOT_TOKEN=

# ---------------------------------------------------------------------------
# Model provider. "none" keeps the system honest (MODEL_UNAVAILABLE).
# One provider is enough for Sprint 2.
#   none | openai | openai_compatible | anthropic
# ---------------------------------------------------------------------------
MODEL_PROVIDER=none
MODEL_NAME=
# Only for MODEL_PROVIDER=openai_compatible (e.g. a self-hosted gateway).
MODEL_BASE_URL=
# Provide only the key for the provider you selected. Env only.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

DEFAULT_MODEL_PROFILE=standard        # economy | standard | strong | critical
MODEL_TIMEOUT_SECONDS=60

# Cost / context controls.
MAX_MODEL_CALLS_PER_TASK=2
CONTEXT_MAX_MESSAGES=12
CONTEXT_MAX_CHARS=12000
